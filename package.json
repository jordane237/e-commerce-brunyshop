{
  "name": "bruny-shopping",
  "version": "0.0.0",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "nx run-many -t test",
    "build": "nx run-many -t build",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{js,mjs,cjs,ts,tsx}": [
      "prettier --write",
      "eslint --fix"
    ],
    "*.{json,md,scss,css,html,yml,yaml,mjml}": [
      "prettier --write"
    ]
  },
  "packageManager": "pnpm@12.11.2",
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@eslint/js": "^9.39.5",
    "@nx/eslint": "23.3.0",
    "@nx/js": "23.3.0",
    "@swc/helpers": "~0.5.18",
    "eslint": "^9.39.5",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "nx": "23.3.0",
    "prettier": "~3.6.2",
    "tslib": "^2.3.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.1"
  }
}
