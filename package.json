{
  "name": "e-commerce-brunyshop",
  "version": "0.0.0",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "lint": "pnpm -C frontend lint",
    "format": "prettier --write .",
    "docker:up": "docker compose up -d --wait",
    "docker:down": "docker compose down",
    "prepare": "husky"
  },
  "lint-staged": {
    "frontend/**/*.{js,mjs,cjs,ts,tsx}": [
      "pnpm -C frontend exec eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,scss,css,html,yml,yaml}": [
      "prettier --write"
    ]
  },
  "packageManager": "pnpm@12.11.2",
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "~3.6.2"
  }
}
