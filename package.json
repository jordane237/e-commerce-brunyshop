{
  "name": "e-commerce-brunyshop",
  "version": "0.0.0",
  "license": "UNLICENSED",
  "private": true,
  "engines": {
    "node": ">=24.11.0 <25"
  },
  "scripts": {
    "lint": "pnpm -C backend lint && pnpm -C frontend lint",
    "format": "prettier --write .",
    "docker:up": "docker compose up -d --wait",
    "docker:down": "docker compose down",
    "dev": "pnpm docker:up && pnpm -C backend dev",
    "dev:api": "pnpm -C backend dev",
    "dev:storefront": "pnpm -C frontend dev:storefront",
    "dev:admin": "pnpm -C frontend dev:admin",
    "build": "pnpm -C backend build && pnpm -C frontend build:storefront && pnpm -C frontend build:admin",
    "test": "pnpm -C backend test && pnpm -C frontend test",
    "test:e2e": "pnpm -C backend test:e2e && pnpm -C frontend test:e2e",
    "typecheck": "pnpm -C backend exec tsc --noEmit -p tsconfig.build.json && pnpm -C frontend exec nx run-many -t typecheck",
    "api:generate": "pnpm -C frontend exec openapi-typescript http://localhost:4000/api/docs-json -o libs/data-access/src/generated/api-types.ts",
    "db:migrate": "pnpm -C backend db:migrate",
    "db:migrate:dev": "pnpm -C backend db:migrate:dev",
    "db:reset": "pnpm -C backend db:reset",
    "db:seed": "pnpm -C backend db:seed",
    "prepare": "husky"
  },
  "lint-staged": {
    "frontend/**/*.{js,mjs,cjs,ts,tsx}": [
      "pnpm -C frontend exec eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,scss,css,html,yml,yaml}": [
      "prettier --write"
    ]
  },
  "packageManager": "pnpm@12.11.2",
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.4",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "~3.6.2"
  }
}
