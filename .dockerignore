# BRUNY SHOPPING — Docker build context exclusions
# Keep pnpm-lock.yaml, prisma/schema.prisma and frontend assets in the context.

# Dependencies (reinstalled in the image)
**/node_modules
.pnpm-store

# Build artifacts (rebuilt in the image)
**/dist
**/build
.angular
.nx
coverage
storybook-static
*.tsbuildinfo

# Environment and secrets
.env
.env.*
!.env.example
!.env.production.example
*.pem
*.key
*.crt

# Tests and documentation (not needed at runtime)
**/*.spec.ts
**/*.test.ts
**/test
**/tests
docs
*.md
!README.md

# IDE and OS files
.vscode
.idea
.DS_Store
Thumbs.db

# Git metadata
.git
.gitignore

# Logs
*.log
npm-debug.log
pnpm-debug.log*

# Large media (normally not committed)
media
*.jpg
*.jpeg
*.png
*.webp
!/assets/**/*.svg

# Generated Prisma client (regenerated by pnpm build)
backend/src/generated
frontend/.angular
">