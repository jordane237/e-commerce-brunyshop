{
  "compilerOptions": {
    "composite": true,
    "declarationMap": true,
    "emitDeclarationOnly": true,
    "importHelpers": true,
    "isolatedModules": true,
    "lib": ["es2022", "dom", "dom.iterable"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "noEmitOnError": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noUnusedLocals": true,
    "skipLibCheck": true,
    "strict": true,
    "target": "es2022",
    "customConditions": ["@bruny-ws/source"],
    "paths": {
      "@bruny/data-access": ["./libs/data-access/src/index.ts"],
      "@bruny/ui": ["./libs/ui/src/index.ts"],
      "@bruny/util": ["./libs/util/src/index.ts"],
      "@bruny/design-tokens": ["./libs/design-tokens/src/index.scss"]
    }
  }
}
