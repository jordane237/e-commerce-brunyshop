# BRUNY SHOPPING — production environment template
# Copy to .env.production and replace every CHANGEME value. Never commit .env.production.
#   cp .env.production.example .env.production

NODE_ENV=production
TZ=Europe/Paris

# --- Application URLs ---
APP_PUBLIC_URL=https://shop.example.com
ADMIN_PUBLIC_URL=https://admin.example.com
NG_ALLOWED_HOSTS=shop.example.com,admin.example.com
CORS_ORIGINS=https://shop.example.com,https://admin.example.com
COOKIE_DOMAIN=.example.com
MEDIA_PUBLIC_URL=https://shop.example.com/media

# --- PostgreSQL ---
POSTGRES_USER=bruny
POSTGRES_PASSWORD=CHANGEME_postgres_password
POSTGRES_DB=bruny

# --- Redis ---
REDIS_PASSWORD=CHANGEME_redis_password

# --- Authentication ---
JWT_ACCESS_SECRET=CHANGEME_REPLACE_WITH_OPENSSL_RAND_BASE64_48
JWT_ACCESS_TTL=15m
REFRESH_TOKEN_TTL=30d

# --- Cloudflare Turnstile ---
TURNSTILE_ENABLED=true
TURNSTILE_SITE_KEY=CHANGEME_turnstile_site_key
TURNSTILE_SECRET_KEY=CHANGEME_turnstile_secret_key
TURNSTILE_VERIFY_URL=https://challenges.cloudflare.com/turnstile/v0/siteverify
TURNSTILE_TIMEOUT_MS=5000

# --- Mail (SMTP) ---
MAIL_DRIVER=smtp
MAIL_FROM=noreply@brunyshopping.example
SMTP_HOST=CHANGEME_smtp_host
SMTP_PORT=587
SMTP_USER=CHANGEME_smtp_user
SMTP_PASSWORD=CHANGEME_smtp_password

# --- MinIO / S3 ---
MINIO_ROOT_USER=bruny
MINIO_ROOT_PASSWORD=CHANGEME_minio_password
MINIO_BUCKET=brunyshop-media
STORAGE_PROVIDER=s3
STORAGE_MAX_FILE_SIZE_MB=5
STORAGE_PRESIGN_EXPIRES_SECONDS=300
STORAGE_MAX_IMAGES_PER_PRODUCT=10
S3_REGION=us-east-1
THROTTLE_TTL=60
THROTTLE_LIMIT=100