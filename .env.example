# =============================================================
# BRUNY SHOPPING — environment variables template
# Copy to .env and fill in real values. NEVER commit .env.
# =============================================================

# --- Application ---
# Environment: development | staging | production
NODE_ENV=development
# API HTTP port
PORT=4000
# Public URL of the storefront (used in emails, links, CORS)
APP_PUBLIC_URL=http://localhost:4200
# Public URL of the admin app
ADMIN_PUBLIC_URL=http://localhost:4201

# --- Database ---
# PostgreSQL credentials (referenced by docker-compose.yml)
POSTGRES_USER=bruny
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=bruny
# Host port for PostgreSQL docker service (15432 avoids common conflicts on 5432)
DB_HOST_PORT=15432
# Connection string used by a locally-run API (Prisma). Port must match DB_HOST_PORT.
# Inside docker-compose (app profile), the API overrides this with db:5432 automatically.
DATABASE_URL=postgresql://bruny:CHANGE_ME@localhost:15432/bruny

# --- Redis ---
# Host port for Redis docker service (16379 avoids common conflicts on 6379)
REDIS_HOST_PORT=16379
# Used by a locally-run API; inside docker-compose the API uses redis:6379 automatically.
REDIS_URL=redis://localhost:16379

# --- Authentication ---
# Long random string (>= 48 chars) used to sign access JWTs. Generate: openssl rand -base64 48
JWT_ACCESS_SECRET=CHANGE_ME
# Access token lifetime, e.g. 15m
JWT_ACCESS_TTL=15m
# Refresh token lifetime, e.g. 30d
REFRESH_TOKEN_TTL=30d
# Cookie domain (leave empty in local dev to allow localhost)
COOKIE_DOMAIN=

# --- CORS ---
# Comma-separated list of allowed origins (whitelist)
CORS_ORIGINS=http://localhost:4200,http://localhost:4201

# --- Seed (development ONLY; seed admin never exists in production) ---
SEED_ADMIN_EMAIL=admin@brunyshopping.example
SEED_ADMIN_PASSWORD=CHANGE_ME

# --- Storage (product images) ---
# local | s3 | cloudinary
STORAGE_DRIVER=local
# S3-compatible settings (only if STORAGE_DRIVER=s3)
S3_ENDPOINT=
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Cloudinary settings (only if STORAGE_DRIVER=cloudinary)
CLOUDINARY_URL=

# --- Mail ---
# Provider: smtp | mailpit (dev)
MAIL_DRIVER=mailpit
MAIL_FROM=noreply@brunyshopping.example
# Mailpit SMTP on the host (11025 maps to container 1025 in docker-compose)
SMTP_HOST=localhost
SMTP_PORT=11025
SMTP_USER=
SMTP_PASSWORD=
# Mailpit web UI port on the host
MAILPIT_UI_PORT=18025
MAILPIT_SMTP_PORT=11025

# --- SMS ---
SMS_DRIVER=stub
SMS_PROVIDER=
SMS_API_KEY=

# --- WhatsApp ---
WHATSAPP_DRIVER=stub
WHATSAPP_TOKEN=

# --- Payments ---
# Provider: fake (MVP: cash on delivery) | mtn_momo | orange_money (later)
PAYMENT_PROVIDER=fake
# Secret used to verify payment provider webhooks
PAYMENT_WEBHOOK_SECRET=CHANGE_ME

# --- Error monitoring (optional) ---
SENTRY_DSN=

# --- Rate limiting ---
# Duration window in seconds
THROTTLE_TTL=60
# Max requests per window per IP
THROTTLE_LIMIT=100
