# =============================================================
# BRUNY SHOPPING — environment variables template
# Copy to .env and replace every CHANGE_ME value. NEVER commit .env.
#   cp .env.example .env
# =============================================================

# --- Application ---
# Environment: development | staging | production
NODE_ENV=development
# API HTTP port (host)
PORT=4000
# Public URL of the storefront (used in emails, links, CORS)
APP_PUBLIC_URL=http://localhost:4200
# Comma-separated storefront hostnames accepted by Angular SSR
NG_ALLOWED_HOSTS=localhost,127.0.0.1
# Public URL of the admin app
ADMIN_PUBLIC_URL=http://localhost:4201

# Host ports used by the optional "full" Docker profile
API_HOST_PORT=4000
STOREFRONT_HOST_PORT=4200
ADMIN_HOST_PORT=4201

# --- PostgreSQL (required by docker-compose.yml) ---
# These values initialise the database on first start. Changing them after the
# volume exists requires an explicit ALTER ROLE / ALTER DATABASE.
POSTGRES_USER=bruny
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=bruny
# Host port for the PostgreSQL container (15432 avoids conflicts with 5432)
DB_HOST_PORT=15432
# Connection string for an API running on the host (Prisma).
# Must match DB_HOST_PORT and the credentials above.
DATABASE_URL=postgresql://bruny:CHANGE_ME@localhost:15432/bruny

# --- Redis ---
# Host port for the Redis container (16379 avoids conflicts with 6379)
REDIS_HOST_PORT=16379
# Used by an API running on the host. Inside Compose the API uses redis:6379.
REDIS_URL=redis://localhost:16379

# --- Authentication ---
# Long random string (>= 48 chars) used to sign access JWTs.
# Generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=CHANGE_ME_REPLACE_WITH_OPENSSL_RAND_BASE64_48_CHARACTERS_MINIMUM
# Access token lifetime, e.g. 15m
JWT_ACCESS_TTL=15m
# Refresh token lifetime, e.g. 30d
REFRESH_TOKEN_TTL=30d
# Cookie domain (leave empty in local dev to allow localhost)
COOKIE_DOMAIN=

# --- CORS ---
CORS_ORIGINS=http://localhost:4200,http://localhost:4201

# --- Seed (development ONLY) ---
SEED_ADMIN_EMAIL=admin@brunyshopping.example
SEED_ADMIN_PASSWORD=CHANGE_ME_admin_password

# --- Mailpit (required by docker-compose.yml) ---
# SMTP port published on the host, and web UI port.
MAILPIT_SMTP_PORT=11025
MAILPIT_UI_PORT=18025
# Used by an API running on the host. Inside Compose the API uses mailpit:1025.
MAIL_DRIVER=mailpit
MAIL_FROM=noreply@brunyshopping.example
SMTP_HOST=localhost
SMTP_PORT=11025
SMTP_USER=
SMTP_PASSWORD=

# --- MinIO (required by docker-compose.yml) ---
# Host ports for the S3 API and the web console.
MINIO_API_PORT=19000
MINIO_CONSOLE_PORT=19001
MINIO_ROOT_USER=bruny
MINIO_ROOT_PASSWORD=CHANGE_ME
MINIO_BUCKET=brunyshop-media
# Used by an API running on the host. Inside Compose the API uses minio:9000.
STORAGE_DRIVER=local
S3_ENDPOINT=http://localhost:19000
S3_BUCKET=brunyshop-media
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=bruny
S3_SECRET_ACCESS_KEY=CHANGE_ME
# Cloudinary settings (only if STORAGE_DRIVER=cloudinary)
CLOUDINARY_URL=

# --- SMS ---
SMS_DRIVER=stub
SMS_PROVIDER=
SMS_API_KEY=

# --- WhatsApp ---
WHATSAPP_DRIVER=stub
WHATSAPP_TOKEN=

# --- Payments ---
# Provider: fake (MVP: cash on delivery) | mtn_momo | orange_money (later)
PAYMENT_PROVIDER=fake
# Secret used to verify payment provider webhooks
PAYMENT_WEBHOOK_SECRET=CHANGE_ME

# --- Error monitoring (optional) ---
SENTRY_DSN=

# --- Rate limiting ---
THROTTLE_TTL=60
THROTTLE_LIMIT=100
