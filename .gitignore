# See https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files for more about ignoring files.

# compiled output
/dist
/backend/dist
/tmp
/out-tsc

# dependencies (root install only; frontend/ carries its own .gitignore)
/node_modules
/frontend/node_modules
/backend/node_modules

# IDEs and editors
/.idea
.project
.classpath
.c9/
*.launch
.settings/
*.sublime-workspace

# IDE - VSCode
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# misc
/.sass-cache
/connect.lock
/coverage
/libpeerconnection.log
npm-debug.log
yarn-error.log
testem.log
*.log
/typings

# Environment files (secrets) — keep the example
.env
.env.*
!.env.example

# System Files
.DS_Store
Thumbs.db

.nx

.claude/worktrees
.claude/settings.local.json

# Session tooling (not project content)
.freebuff/

# Confidential specs (local only)
Cahier_des_charges_BRUNY_SHOPPING.docx

# generated code (prisma client, rebuilt by `pnpm build`)
backend/src/generated

# Frontend build/test caches
frontend/.angular/
frontend/test-results/
frontend/playwright-report/
