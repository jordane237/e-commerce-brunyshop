  "info": {
    "title": "BRUNY SHOPPING API",
    "description": "BRUNY SHOPPING e-commerce contract (prices in FCFA).",
    "version": "1.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "schemas": {
      "RegisterDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "example": "client@exemple.cm"
          },
          "phone": {
            "type": "string",
            "example": "+237612345678",
            "description": "Format strict +237 suivi de 9 chiffres"
          },
          "password": {
            "type": "string",
            "minLength": 10,
            "maxLength": 128
          },
          "firstName": {
            "type": "string",
            "example": "Jean",
            "maxLength": 100
          },
          "lastName": {
            "type": "string",
            "example": "Dupont",
            "maxLength": 100
          },
          "termsAccepted": {
            "type": "boolean",
            "example": true,
            "description": "Consentement aux CGV (obligatoire)"
          },
          "termsVersion": {
            "type": "string",
            "example": "1.0",
            "description": "Version des CGV acceptée"
          }
        },
        "required": ["password", "termsAccepted", "termsVersion"]
      },
      "LoginDto": {
        "type": "object",
        "properties": {
          "identifier": {
            "type": "string",
            "example": "client@exemple.cm ou +2376XXXXXXXX"
          },
          "password": {
            "type": "string"
          }
        },
        "required": ["identifier", "password"]
      },
      "ForgotPasswordDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "example": "client@exemple.cm"
          }
        },
        "required": ["email"]
      },
      "ResetPasswordDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "example": "client@exemple.cm"
          },
          "code": {
            "type": "string",
            "description": "6-digit code received by email"
          },
          "newPassword": {
            "type": "string",
            "minLength": 10,
            "description": "Minimum 10 chars, server-checked"
          }
        },
        "required": ["email", "code", "newPassword"]
      },
      "TwoFactorVerifyDto": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "description": "TOTP 6 digits or backup code 8 digits"
          }
        },
        "required": ["code"]
      },
      "Object": {
        "type": "object",
        "properties": {}
      },
      "CreateProductVariantDto": {
        "type": "object",
        "properties": {
          "sku": {
            "type": "string"
          },
          "color": {
            "type": "string"
          },
          "size": {
            "type": "string"
          },
          "price": {
            "type": "number",
            "minimum": 0
          },
          "stock": {
            "type": "object",
            "minimum": 0,
            "default": 0
          }
        },
        "required": ["sku", "color", "size"]
      },
      "CreateProductDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "slug": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "categoryId": {
            "type": "string"
          },
          "brandId": {
            "type": "string"
          },
          "basePrice": {
            "type": "number",
            "minimum": 0,
            "description": "Montant entier en FCFA"
          },
          "variants": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CreateProductVariantDto"
            }
          }
        },
        "required": ["name", "slug", "description", "categoryId", "brandId", "basePrice"]
      },
      "CartItemInputDto": {
        "type": "object",
        "properties": {
          "variantId": {
            "type": "string",
            "format": "uuid",
            "description": "Identifiant de la variante"
          },
          "quantity": {
            "type": "number",
            "minimum": 1,
            "maximum": 100,
            "description": "Quantité souhaitée (1 à 100 par ligne)"
          },
          "previousUnitPrice": {
            "type": "number",
            "minimum": 0,
            "description": "Prix unitaire mémorisé côté client. Information seule : jamais utilisé dans un calcul, uniquement pour signaler un écart de prix."
          }
        },
        "required": ["variantId", "quantity"]
      },
      "ValidateCartDto": {
        "type": "object",
        "properties": {
          "items": {
            "description": "Lignes du panier (1 à 50)",
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CartItemInputDto"
            }
          },
          "couponCode": {
            "type": "string",
            "description": "Code promo à appliquer (optionnel)",
            "maxLength": 64
          }
        },
        "required": ["items"]
      },
      "CartIssueDto": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "enum": [
              "PRICE_CHANGED",
              "PROMO_APPLIED",
              "PROMO_EXPIRED",
              "INSUFFICIENT_STOCK",
              "OUT_OF_STOCK",
              "PRODUCT_ARCHIVED",
              "PRODUCT_NOT_FOUND",
              "VARIANT_NOT_FOUND",
              "QUANTITY_EXCEEDED",
              "COUPON_INVALID",
              "COUPON_MIN_AMOUNT_NOT_REACHED"
            ],
            "description": "Code de l'écart"
          },
          "message": {
            "type": "string",
            "description": "Message en français prêt à afficher"
          },
          "variantId": {
            "type": "string",
            "format": "uuid",
            "description": "Variante concernée"
          },
          "productId": {
            "type": "string",
            "format": "uuid",
            "description": "Produit concerné"
          },
          "couponCode": {
            "type": "string",
            "description": "Code promo concerné"
          },
          "requestedQuantity": {
            "type": "number",
            "description": "Quantité demandée par le client"
          },
          "availableQuantity": {
            "type": "number",
            "description": "Stock disponible réellement"
          },
          "maxQuantity": {
            "type": "number",
            "description": "Quantité maximale autorisée par ligne"
          },
          "previousPrice": {
            "type": "number",
            "description": "Prix unitaire mémorisé côté client"
          },
          "currentPrice": {
            "type": "number",
            "description": "Prix unitaire recalculé côté serveur"
          },
          "minAmount": {
            "type": "number",
            "description": "Montant minimum requis par le coupon"
          },
          "subtotal": {
            "type": "number",
            "description": "Sous-total utilisé pour évaluer le coupon"
          }
        },
        "required": ["code", "message"]
      },
      "CartItemValidationDto": {
        "type": "object",
        "properties": {
          "variantId": {
            "type": "string",
            "format": "uuid"
          },
          "productId": {
            "type": "string",
            "format": "uuid"
          },
          "productName": {
            "type": "string"
          },
          "variantSku": {
            "type": "string"
          },
          "size": {
            "type": "string"
          },
          "color": {
            "type": "string"
          },
          "quantity": {
            "type": "number",
            "description": "Quantité retenue (limitée au stock disponible)"
          },
          "availableStock": {
            "type": "number",
            "description": "Stock disponible = stock - stock réservé"
          },
          "unitPrice": {
            "type": "number",
            "description": "Prix unitaire recalculé côté serveur (XAF)"
          },
          "lineTotal": {
            "type": "number",
            "description": "unitPrice × quantity (XAF)"
          },
          "issues": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CartIssueDto"
            }
          }
        },
        "required": [
          "variantId",
          "productId",
          "productName",
          "variantSku",
          "size",
          "color",
          "quantity",
          "availableStock",
          "unitPrice",
          "lineTotal",
          "issues"
        ]
      },
      "CartValidationMetaDto": {
        "type": "object",
        "properties": {
          "validatedAt": {
            "type": "string",
            "example": "2025-01-15T10:30:00.000Z"
          },
          "itemCount": {
            "type": "number",
            "description": "Nombre de lignes retournées"
          },
          "totalQuantity": {
            "type": "number",
            "description": "Somme des quantités retenues"
          }
        },
        "required": ["validatedAt", "itemCount", "totalQuantity"]
      },
      "CartValidationResponseDto": {
        "type": "object",
        "properties": {
          "valid": {
            "type": "boolean",
            "description": "false dès qu’au moins une issue bloquante est présente"
          },
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CartItemValidationDto"
            }
          },
          "subtotal": {
            "type": "number",
            "description": "Sous-total recalculé (XAF)"
          },
          "discount": {
            "type": "number",
            "description": "Remise coupon (XAF)"
          },
          "total": {
            "type": "number",
            "description": "Total à payer hors livraison (XAF), jamais négatif"
          },
          "issues": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CartIssueDto"
            }
          },
          "meta": {
            "$ref": "#/components/schemas/CartValidationMetaDto"
          }
        },
        "required": ["valid", "items", "subtotal", "discount", "total", "issues", "meta"]
      }
    }
  }
}
