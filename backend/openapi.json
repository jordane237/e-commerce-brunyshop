    "/api/v1/products": {
      "get": {
        "operationId": "CatalogController_listProducts_v1",
        "parameters": [
          {
            "name": "page",
            "required": false,
            "in": "query",
            "schema": {
              "minimum": 1,
              "default": 1,
              "allOf": [
                {
                  "$ref": "#/components/schemas/Object"
                }
              ]
            }
          },
          {
            "name": "limit",
            "required": false,
            "in": "query",
            "schema": {
              "minimum": 1,
              "maximum": 48,
              "default": 12,
              "allOf": [
                {
                  "$ref": "#/components/schemas/Object"
                }
              ]
            }
          },
          {
            "name": "category",
            "required": false,
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "size",
            "required": false,
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "color",
            "required": false,
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "minPrice",
            "required": false,
            "in": "query",
            "schema": {
              "minimum": 0,
              "type": "number"
            }
          },
          {
            "name": "maxPrice",
            "required": false,
            "in": "query",
            "schema": {
              "minimum": 0,
              "type": "number"
            }
          },
          {
            "name": "sort",
            "required": false,
            "in": "query",
            "schema": {
              "type": "string",
              "enum": ["newest", "price_asc", "price_desc", "name"]
            }
          },
          {
            "name": "q",
            "required": false,
            "in": "query",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": ""
          }
        },
        "summary": "Liste paginée du catalogue public",
        "tags": ["catalog"]
      }
    },
    "/api/v1/products/{slug}": {
      "get": {
        "operationId": "CatalogController_getProduct_v1",
        "parameters": [
          {
            "name": "slug",
            "required": true,
            "in": "path",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": ""
          }
        },
        "summary": "Détail public d’un produit publié",
        "tags": ["catalog"]
      }
    },
    "/api/v1/categories": {
      "get": {
        "operationId": "CatalogController_listCategories_v1",
        "parameters": [],
        "responses": {
          "200": {
            "description": ""
          }
        },
        "summary": "Catégories ayant des produits publiés",
        "tags": ["catalog"]
      }
    },
    "/api/v1/admin/products": {
      "post": {
        "operationId": "CatalogController_createProduct_v1",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateProductDto"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": ""
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Création d’un produit en brouillon avec variantes",
        "tags": ["catalog"]
      }
    }
  },
  "info": {
    "title": "BRUNY SHOPPING API",
    "description": "BRUNY SHOPPING e-commerce contract (prices in FCFA).",
    "version": "1.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "schemas": {
      "RegisterDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "example": "client@exemple.cm"
          },
          "phone": {
            "type": "string",
            "example": "+2376XXXXXXXX"
          },
          "firstName": {
            "type": "string",
            "minLength": 3
          },
          "lastName": {
            "type": "string",
            "minLength": 3
          },
          "password": {
            "type": "string",
            "minLength": 10,
            "description": "Minimum 10 chars, server-checked"
          }
        },
        "required": ["firstName", "lastName", "password"]
      },
      "LoginDto": {
        "type": "object",
        "properties": {
          "identifier": {
            "type": "string",
            "example": "client@exemple.cm ou +2376XXXXXXXX"
          },
          "password": {
            "type": "string"
          }
        },
        "required": ["identifier", "password"]
      },
      "ForgotPasswordDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "example": "client@exemple.cm"
          }
        },
        "required": ["email"]
      },
      "ResetPasswordDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "example": "client@exemple.cm"
          },
          "code": {
            "type": "string",
            "description": "6-digit code received by email"
          },
          "newPassword": {
            "type": "string",
            "minLength": 10,
            "description": "Minimum 10 chars, server-checked"
          }
        },
        "required": ["email", "code", "newPassword"]
      },
      "TwoFactorVerifyDto": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "description": "TOTP 6 digits or backup code 8 digits"
          }
        },
        "required": ["code"]
      },
      "Object": {
        "type": "object",
        "properties": {}
      },
      "CreateProductVariantDto": {
        "type": "object",
        "properties": {
          "sku": {
            "type": "string"
          },
          "color": {
            "type": "string"
          },
          "size": {
            "type": "string"
          },
          "price": {
            "type": "number",
            "minimum": 0
          },
          "stock": {
            "type": "object",
            "minimum": 0,
            "default": 0
          }
        },
        "required": ["sku", "color", "size"]
      },
      "CreateProductDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "slug": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "categoryId": {
            "type": "string"
          },
          "brandId": {
            "type": "string"
          },
          "basePrice": {
            "type": "number",
            "minimum": 0,
            "description": "Montant entier en FCFA"
          },
          "variants": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CreateProductVariantDto"
            }
          }
        },
        "required": ["name", "slug", "description", "categoryId", "brandId", "basePrice"]
      }
    }
  }
}
