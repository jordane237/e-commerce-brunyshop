# BRUNY SHOPPING — fichier d'exemple des variables d'environnement.
# Copier ce fichier en .env (backend/.env) et remplir les valeurs.
# .env n'est PAS versionné. .env.example l'est.
#
# ---------------------------------------------------------------------------
# Environnement
# ---------------------------------------------------------------------------
NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://brunyshop:brunyshop@localhost:15432/brunyshop?schema=public
REDIS_URL=redis://localhost:6379/0
CORS_ORIGINS=http://localhost:4200,http://localhost:4300
APP_PUBLIC_URL=http://localhost:4200
ADMIN_PUBLIC_URL=http://localhost:4300
THROTTLE_TTL=60
THROTTLE_LIMIT=100
JWT_ACCESS_SECRET=CHANGE_ME_JWT_ACCESS_SECRET_48+caracteres
JWT_ACCESS_TTL=15m
REFRESH_TOKEN_TTL=30d

# ---------------------------------------------------------------------------
# Seed (TEC-07) — données de démonstration
# ---------------------------------------------------------------------------
# Adresse email du super admin de développement (obligatoire).
# Jamais en dur dans le code : elle vient ici.
SEED_SUPER_ADMIN_EMAIL=admin@brunyshop.local
# Mot de passe du super admin (obligatoire, >= 12 caractères).
# Jamais en dur dans le code : il vient ici.
# IMPORTANT : le seed refuse de s'exécuter en production si la clé
# DATABASE_URL contient "prod" (case-insensitive) et si
# ALLOW_SEED_IN_PRODUCTION n'est pas 'true'.
SEED_SUPER_ADMIN_PASSWORD=CHANGEME_min_12_chars
# Forcer le changement de mot de passe du super admin lors du seed.
# La valeur par défaut est 'false'.
SEED_FORCE_PASSWORD_RESET=false
# Mot de passe du client de démonstration (obligatoire, >= 12 caractères).
SEED_CUSTOMER_PASSWORD=SEED_CUSTOMER_PASSWORD

# ---------------------------------------------------------------------------
# Stockage (MinIO / S3) — optionnel en dev
# ---------------------------------------------------------------------------
STORAGE_DRIVER=minio
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=brunyshop
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin

# ---------------------------------------------------------------------------
# Messagerie
# ---------------------------------------------------------------------------
MAIL_DRIVER=console
MAIL_FROM=no-reply@brunyshop.local
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMS_DRIVER=console
SMS_PROVIDER=
SMS_API_KEY=
WHATSAPP_DRIVER=console
WHATSAPP_TOKEN=
PAYMENT_PROVIDER=console
PAYMENT_WEBHOOK_SECRET=change-me

# ---------------------------------------------------------------------------
# Monitoring
# ---------------------------------------------------------------------------
SENTRY_DSN=
ALLOW_SEED_IN_PRODUCTION=false
