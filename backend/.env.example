# BRUNY SHOPPING — fichier d'exemple des variables d'environnement.
# Copier ce fichier en .env (backend/.env) et remplir les valeurs.
# .env n'est PAS versionné. .env.example l'est.
#
# ---------------------------------------------------------------------------
# Environnement
# ---------------------------------------------------------------------------
NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://brunyshop:brunyshop@localhost:15432/brunyshop?schema=public
REDIS_URL=redis://localhost:6379/0
CORS_ORIGINS=http://localhost:4200,http://localhost:4300
APP_PUBLIC_URL=http://localhost:4200
ADMIN_PUBLIC_URL=http://localhost:4300
THROTTLE_TTL=60
THROTTLE_LIMIT=100
JWT_ACCESS_SECRET=CHANGE_ME_JWT_ACCESS_SECRET_48+caracteres
JWT_ACCESS_TTL=15m
REFRESH_TOKEN_TTL=30d

# ---------------------------------------------------------------------------
# Catalogue (CAT-03) — fiche produit
# ---------------------------------------------------------------------------
# Durée de vie du cache Redis de la fiche produit, en secondes (défaut : 300).
# Un changement de prix/stock met donc au plus 5 min à apparaître (acceptable MVP).
CACHE_PRODUCT_DETAIL_TTL_SECONDS=300
# Durée de vie du cache Redis de la liste et des facettes, en secondes (défaut : 60).
CACHE_PRODUCTS_LIST_TTL_SECONDS=60
# Durée de vie du cache Redis des guides de tailles (défaut : 1800 s = 30 min).
CACHE_SIZE_GUIDES_TTL_SECONDS=1800
# Nombre de produits similaires renvoyés sur la fiche produit (1 à 12, défaut : 6).
SIMILAR_PRODUCTS_LIMIT=6

# ---------------------------------------------------------------------------
# Seed (TEC-07) — données de démonstration
# ---------------------------------------------------------------------------
# Adresse email du super admin de développement (obligatoire).
# Jamais en dur dans le code : elle vient ici.
SEED_SUPER_ADMIN_EMAIL=admin@brunyshop.local
# Mot de passe du super admin (obligatoire, >= 12 caractères).
# Jamais en dur dans le code : il vient ici.
# IMPORTANT : le seed refuse de s'exécuter en production si la clé
# DATABASE_URL contient "prod" (case-insensitive) et si
# ALLOW_SEED_IN_PRODUCTION n'est pas 'true'.
SEED_SUPER_ADMIN_PASSWORD=CHANGEME_min_12_chars
# Forcer le changement de mot de passe du super admin lors du seed.
# La valeur par défaut est 'false'.
SEED_FORCE_PASSWORD_RESET=false
# Mot de passe du client de démonstration (obligatoire, >= 12 caractères).
SEED_CUSTOMER_PASSWORD=SEED_CUSTOMER_PASSWORD

# ---------------------------------------------------------------------------
# Stockage média (CAT-05) — MinIO / S3 / local / fake
# ---------------------------------------------------------------------------
# s3 = MinIO/S3/R2 (dev/prod), local = disque hors public/dist, fake = tests.
STORAGE_PROVIDER=s3
STORAGE_MAX_FILE_SIZE_MB=5
STORAGE_PRESIGN_EXPIRES_SECONDS=300
STORAGE_MAX_IMAGES_PER_PRODUCT=10
# Racine locale si STORAGE_PROVIDER=local (jamais dans public/ ou dist/).
STORAGE_LOCAL_ROOT=storage/uploads
# Base utilisée pour les URLs locales (upload signé et lecture).
MEDIA_UPLOAD_BASE_URL=http://localhost:4000

# Bucket et URL publique. En dev MinIO, MEDIA_PUBLIC_URL doit être joignable
# depuis le navigateur (port hôte 19000), pas depuis le réseau Docker.
MEDIA_BUCKET=brunyshop-media
MEDIA_PUBLIC_URL=http://localhost:19000/brunyshop-media

# Credentials S3/MinIO : jamais exposés au frontend, seul le backend signe.
S3_ENDPOINT=http://localhost:19000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=CHANGEME_minio_access_key
S3_SECRET_ACCESS_KEY=CHANGEME_minio_secret_key
S3_FORCE_PATH_STYLE=true

# ---------------------------------------------------------------------------
# Messagerie
# ---------------------------------------------------------------------------
MAIL_DRIVER=console
MAIL_FROM=no-reply@brunyshop.local
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMS_DRIVER=console
SMS_PROVIDER=
SMS_API_KEY=
WHATSAPP_DRIVER=console
WHATSAPP_TOKEN=
PAYMENT_PROVIDER=console
PAYMENT_WEBHOOK_SECRET=change-me

# ---------------------------------------------------------------------------
# Cloudflare Turnstile (AUT-11)
# ---------------------------------------------------------------------------
# CAPTCHA invisible sur register/login/orders/contact. En production, remplacer
# impérativement les clés de test par celles du widget Cloudflare.
TURNSTILE_ENABLED=true
TURNSTILE_SITE_KEY=1x00000000000000000000BB
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
TURNSTILE_VERIFY_URL=https://challenges.cloudflare.com/turnstile/v0/siteverify
TURNSTILE_TIMEOUT_MS=5000
# Clés de test Cloudflare documentées (jamais utiliser en production) :
# always passes : site 1x00000000000000000000BB / secret 1x0000000000000000000000000000000AA
# always fails  : site 2x00000000000000000000BB / secret 2x0000000000000000000000000000000AA
# dummy token   : XXXX.DUMMY.TOKEN.XXXX

# ---------------------------------------------------------------------------
# Monitoring
# ---------------------------------------------------------------------------
SENTRY_DSN=
ALLOW_SEED_IN_PRODUCTION=false
