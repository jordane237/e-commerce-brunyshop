# syntax=docker/dockerfile:1.7
# =============================================================================
# Stage 1: Base — Node.js Alpine
# =============================================================================
FROM node:24.15-alpine AS base
WORKDIR /app
RUN corepack enable && apk upgrade --no-cache

# =============================================================================
# Stage 2: Dependencies — install the workspace with the frozen lockfile
# =============================================================================
FROM base AS deps
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY backend/package.json backend/
COPY backend/prisma backend/prisma
COPY backend/prisma.config.mjs backend/
RUN --mount=type=cache,target=/root/.local/share/pnpm/store \
    pnpm install --frozen-lockfile

# =============================================================================
# Stage 3: Build — generate Prisma Client and compile NestJS
# =============================================================================
FROM deps AS build
COPY backend backend
RUN pnpm -C backend build
RUN pnpm prune --prod
RUN test -f backend/dist/main.js || (echo "Build failed: backend/dist/main.js missing" && exit 1)

# =============================================================================
# Stage 4: Runtime — minimal Node image, non-root
# =============================================================================
FROM node:24.15-alpine AS runtime
RUN apk upgrade --no-cache && rm -rf /usr/local/lib/node_modules/npm /usr/local/bin/npm /usr/local/bin/npx
RUN addgroup -S bruny && adduser -S bruny -G bruny
WORKDIR /app

COPY --from=build --chown=bruny:bruny /app/node_modules ./node_modules
COPY --from=build --chown=bruny:bruny /app/backend/node_modules ./backend/node_modules
COPY --from=build --chown=bruny:bruny /app/backend/dist ./backend/dist
COPY --from=build --chown=bruny:bruny /app/backend/prisma ./backend/prisma
COPY --from=build --chown=bruny:bruny /app/backend/src/generated ./backend/src/generated
COPY --from=build --chown=bruny:bruny /app/backend/package.json ./backend/package.json
COPY --from=build --chown=bruny:bruny /app/backend/prisma.config.mjs ./backend/prisma.config.mjs

EXPOSE 4000
HEALTHCHECK --interval=30s --timeout=5s --start-period=30s --retries=3 \
    CMD wget -qO- http://127.0.0.1:4000/api/v1/health/live || exit 1

USER bruny
ENV NODE_ENV=production
ENV PORT=4000
WORKDIR /app/backend
CMD ["node", "dist/main.js"]