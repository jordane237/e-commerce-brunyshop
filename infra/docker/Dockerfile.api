FROM node:24.15-alpine AS build
WORKDIR /workspace
RUN corepack enable
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY backend/package.json backend/package.json
COPY frontend/package.json frontend/package.json
RUN pnpm install --frozen-lockfile
COPY backend backend
RUN pnpm -C backend build

FROM node:24.15-alpine AS runtime
ENV NODE_ENV=production PORT=4000
WORKDIR /app
RUN addgroup -S bruny && adduser -S bruny -G bruny
COPY --from=build --chown=bruny:bruny /workspace/node_modules ./node_modules
COPY --from=build --chown=bruny:bruny /workspace/backend/node_modules ./backend/node_modules
COPY --from=build --chown=bruny:bruny /workspace/backend/dist ./backend/dist
COPY --from=build --chown=bruny:bruny /workspace/backend/package.json ./backend/package.json
WORKDIR /app/backend
USER bruny
EXPOSE 4000
CMD ["node", "dist/main.js"]
