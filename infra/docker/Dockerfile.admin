FROM node:24.15-alpine AS build
WORKDIR /workspace
RUN corepack enable
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY backend/package.json backend/package.json
COPY frontend/package.json frontend/package.json
RUN pnpm install --frozen-lockfile
COPY frontend frontend
RUN pnpm -C frontend exec ng build admin --configuration=production

FROM nginx:1.29-alpine AS runtime
COPY infra/docker/nginx.admin.conf /etc/nginx/conf.d/default.conf
COPY --from=build /workspace/frontend/dist/apps/admin/browser /usr/share/nginx/html
RUN mkdir -p /var/cache/nginx /var/run && chown -R nginx:nginx /var/cache/nginx /var/run /usr/share/nginx/html
USER nginx
EXPOSE 8080
CMD ["nginx", "-g", "daemon off;"]
